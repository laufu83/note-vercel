{
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "buildCommand": "tsc",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "functions": {
    "src/index.node.ts": {
      "runtime": "nodejs24.x",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.node.ts"
    }
  ]
}